<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Androsova.Models"
             xmlns:style="clr-namespace:Androsova.Models"
             x:Class="Androsova.Views.About"
             Title="About"
             BackgroundColor="{x:Static style:PlatformStyle.BackgroundColor}">

    <ContentPage.BindingContext>
        <models:About />
    </ContentPage.BindingContext>
    
    <VerticalStackLayout>
        <Image
            Source="timka.png"
            HeightRequest="185"
            Aspect="AspectFit"
            SemanticProperties.Description="dot net bot in a race car number eight" />

        <Label 
            Text="{Binding AboutText}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button
            x:Name="CounterBtn"
            Text="Перейти на сайт" 
            Clicked="OnCounterClicked"
            HorizontalOptions="Fill"
            BackgroundColor="{x:Static style:PlatformStyle.ButtonColor}"
            TextColor="{x:Static style:PlatformStyle.ButtonTextColor}"/>
    </VerticalStackLayout>
</ContentPage>