<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Androsova.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Androsova.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Androsova">
    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate views:About}"
            Route="About" />
        
        <ShellContent
            Title="Note"
            ContentTemplate="{DataTemplate views:Notes}"
            Route="Notes" />
    </TabBar>
</Shell>
